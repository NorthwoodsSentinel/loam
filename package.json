{
  "name": "loam",
  "version": "0.1.0",
  "description": "Loam. The memory substrate for personal AI. Search your AI history on your own Cloudflare. BYOK sovereignty. The soil layer beneath whatever you build on top.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "schema": "wrangler d1 execute loam --remote --file=schema.sql",
    "ingest:claude": "bun ingest/claude.ts",
    "ingest:files": "bun ingest/files.ts",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p ingest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261031.1",
    "@types/node": "22.10.2",
    "typescript": "^5.9.3",
    "wrangler": "^4.156.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
